# Copy to .env (repo root) and fill in.

# PayPal sandbox REST app (developer.paypal.com -> Apps & Credentials).
# The app must have "Save payment methods" (Vault) enabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Filled in after the one-time Vault approval (see backend/scripts/vault_poc.py).
# Leave empty to run with the plain create-order fallback.
PAYPAL_VAULT_ID=

# Anthropic API key (Claude Haiku 5.5 for proposals + classification).
ANTHROPIC_API_KEY=

# Optional overrides.
# DATABASE_URL=sqlite:///./guardrail.db
# CORS_ORIGINS=["http://localhost:5173"]
